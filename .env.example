# ==============================================================================
# uTrack Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your local or production environment.

# ------------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# ------------------------------------------------------------------------------
# 2. PRIMARY DATABASE (PostgreSQL)
# Note: If left blank or DB_NAME is empty, the application falls back to SQLite.
# ------------------------------------------------------------------------------
DB_NAME=utrack
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. CACHING & IN-MEMORY STORE (Redis)
# Note: Used for caching open provider search results and session storage.
# If left blank, falls back to LocMemCache (local memory cache).
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 4. EXTERNAL OPEN DATABASE PROVIDERS
# ------------------------------------------------------------------------------

# [MOVIES & TV SERIES]
# The Movie Database (TMDB) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# [BOOKS & LITERATURE]
# Open Library is public and requires no key: https://openlibrary.org/developers/api
# Google Books API key is optional for higher rate limits: https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# [COMICS & GRAPHIC NOVELS]
# Comic Vine API — https://comicvine.gamespot.com/api/
COMIC_VINE_API_KEY=

# [ANIME & MANGA]
# AniList GraphQL API is public and requires no API key.
# Jikan (MyAnimeList open API) is public and requires no API key.
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_URL=https://api.jikan.moe/v4

# [AUDIOBOOKS]
# iTunes Search API & LibriVox are public and require no key.
ITUNES_SEARCH_API_URL=https://itunes.apple.com/search

# [VIDEO GAMES]
# IGDB API (via Twitch Developer OAuth) — https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# RAWG Video Games Database API (fallback / direct REST) — https://rawg.io/apidocs
RAWG_API_KEY=

# [BOARD GAMES]
# BoardGameGeek (BGG) XML API2 — https://boardgamegeek.com/xmlapi2/
BGG_API_TOKEN=
BGG_API_URL=https://boardgamegeek.com/xmlapi2

# ------------------------------------------------------------------------------
# 5. S3 / OBJECT STORAGE (Optional)
# If configured, media files are stored on S3 or S3-compatible service (MinIO/Garage).
# If left empty, local filesystem storage is used (./media).
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
